# Travelogue 本地配置样例 · research / 全量面（CSC W3b）
# 复制为 config.yaml 并勿提交到 Git
#
# 用户档（L0 + L1≤10）请优先复制：config.user.example.yaml
# 本文件保留深参与实验旗标，供对照与研究；勿把整文件当作「常用设置」清单。
#
# 说明：config.py 读取 trips_dir / ingest / layout / export / vision / narrative / llm。
# ffmpeg / geocode 段：geocode.enabled 已接入 ingest（Nominatim + 本地缓存）；ffmpeg 仍为规划预留。

trips_dir: ./trips

llm:
  # 桌面 / Studio L0 默认：本机文案（无需 API Key 即可导入→预览→长图）
  # 升级杂志感文案：在 Studio「设置 → AI 文案」配置 Key，或取消注释下方 deepseek/dashscope 示例
  provider: stub                  # stub | deepseek | dashscope
  model: deepseek-chat
  api_key_env: DEEPSEEK_API_KEY   # 密钥写在项目根 .env（见 .env.example），或系统环境变量
  timeout_sec: 120
  # --- 可选：DeepSeek ---
  # provider: deepseek
  # model: deepseek-chat
  # api_key_env: DEEPSEEK_API_KEY
  # --- 可选：通义千问（百炼）---
  # provider: dashscope
  # model: qwen-plus
  # api_key_env: DASHSCOPE_API_KEY

# --- 规划预留（未接入 runtime）---
ffmpeg:
  path: ffmpeg

geocode:
  enabled: false
  provider: null
  api_key_env: null

# Bookends Engine（封面–封底）· B1 默认 opening_hard_gate=false
bookends:
  enabled: true
  pairing_version: v1
  opening_quality_version: v2
  closing_scorer_version: v1
  lock_after_resolve: true
  mobile_closing: false
  pairing:
    require_hard: true
    soft_weight: 0.35
    near_dup_seconds: 3
  title_safe:
    opening_hard_gate: true   # B2a 默认；可回滚 false
  plugins:
    opening_vl_rerank: false
    closing_vl_rerank: false
  telemetry: true

curate:
  segment_gap_days: 14
  city_gap_days: 3
  min_bucket_size: 3
  chapter_balance_enabled: true
  chapter_balance_ratio: 0.55
  arc_mode: legacy
  arc_flat_variance_threshold: 0.08
  featured_weight: 1.35
  featured_min_for_cover_pool: 2
  # Phase 23 · 最佳时刻（高光池 + 签名屏 + EXIF）
  moment:
    enabled: true
    pool_ratio: 0.05
    pool_min: 1
    pool_max: 5
    show_exif: true
    pool_solo: true          # 池内全部单独成屏（false → 仅签名 solo）
    pool_exif: true          # 池内全部挂 EXIF（false → 仅签名）
    signature_label: true    # 仅签名显示「决定性瞬间」角标
    position: inline
    auto_disable_small_trip: true
    small_trip_max_assets: 15
    secondary_boost: 0.12    # pool_solo=true 时自动降为 0（次高峰已 solo）
    scoring:
      min_score: 0.35
      small_trip_elevated_min_score: 0.45
      weights:
        arc_peak: 0.30
        anchor: 0.25
        aesthetic: 0.20
        on_screen: 0.15
        featured: 0.10
  # 封面选型 · cover-selection-plan v0.2（默认=当前代码行为）
  cover_scoring_version: v2   # v1 | v2（默认 v2 加性 logit）
  cover_scoring:
    person_demote: 0.72
    person_demote_portrait_trip: 1.0
    person_dominant_tag_ratio: 0.40
    face_bbox_boost: 1.06
    sharp_ratio_cap: 1.25
    sharp_ratio_floor: 0.35
    enable_phase6_factors: true
  # cover_scoring_v2:  # 切换 version: v2 时生效
  #   weights:
  #     layout_fit: 0.23
  #     sharpness: 0.25
  #     thirds: 0.15
  # Phase 10 · food grid（见 docs/PRD-PHASE10-food-grid.md）
  enable_food_grid: true
  # Phase 10.1 · 可配置 mundane 组屏桶（默认仅 food）
  mundane_grid_buckets: [food]
  # Phase 6 · layout rhythm & diversity (M25-B)
  layout:
    enable_gravity_balance: true
    enable_mmr_diversity: true
    max_consecutive_same_pattern: 2
    longshot_mmr_lambda: 0.72
    enable_arc_breath: true

# Phase 23 · moment 选型审美权重（见 docs/PRD-PHASE23-peak-moment.md §11）
aesthetic:
  presets:
    moment:
      composition: 0.28
      subjectClarity: 0.28
      lighting: 0.22
      exposure: 0.12
      color: 0.10
  # AA 人类审美对齐（默认关；灰度见 docs/aesthetic-alignment/config-aesthetic-alignment.example.yaml）
  # ml_calibrate: false
  # use_stratum_blend: false
  # portrait_lite_enabled: true
  # mllm:
  #   enabled: false
  #
  # --- G1c 分层精选 pilot 冻结（v3 · AC-SC-03 dogfood）---
  # 完整快照：docs/acceptance-records/aesthetic-pilot-config.freeze.v3.yaml
  # Signoff：docs/aesthetic-alignment/SIGNOFF-PILOT-FREEZE.v3.md
  # ml_calibrate: true
  # use_stratum_blend: true
  # stratum_blend_only: [landscape, person]
  # stratum_blend_only_by_purpose:
  #   hero: [landscape]
  # stratum_blends:
  #   person: 0.6
  #   landscape: 0.6
  # use_album_relative: true
  # album_relative_percentile: 0.75
  # album_relative_lo: 0.7
  # album_relative_hi: 1.3
  # presets:
  #   cover:
  #     subjectClarity: 0.55
  # mllm:
  #   enabled: true
  #   shortlist_purposes: [moment]
  # portrait_lite_enabled: true

# 精细制作「版面密度」旋钮（false → 全体当智能平衡）
layoutDensity:
  enabled: true

# Web 排版引擎：legacy（media-row）| screens（16:9 舞台）；exportLayout=web|auto 宽屏时生效
layout:
  web_layout_engine: screens
  # 组屏范围：day=按策展日桶时间序全序列；chapter=仅章内 items 顺序
  screen_plan_scope: day
  # 混排/拼图连拍 takenAt 最大跨度（秒）· 默认 1800 = 30min
  mixed_proximity_seconds: 1800
  # 三竖 editorial row（screen-portrait-3-editorial）· 默认关闭
  editorial_portrait_row:
    enabled: false
    replace_patterns:
      - screen-portrait-3
    scope: all              # all | person | scenery
    trip_allowlist: []
  # 四图横竖棋盘 editorial-4mix · 默认关闭
  editorial_4mix:
    enabled: false
    replace_patterns:
      - screen-portrait-2-landscape-2
    trip_allowlist: []
    scenery_portrait_cover_random: true   # P2 · 纯风景竖槽 cover/contain 确定性随机
  # 节奏阈值与后几章竖版收束（前几章维持 defer/carry outward）
  rhythm:
    max_portrait_pair_streak: 2
    max_portrait_orientation_streak: 6
    portrait_carry_max_hops: 0
    late_chapter_pairing:
      from_chapter_index: 3   # 1-based · 第 3 章起加强成对
      reset_orientation_streak: true
      reset_pair_streak: true
      no_outward_portrait_carry: true
      flush_lookahead_portraits: 3
      beam_portrait_single_penalty: 0.12
      beam_portrait_pair_bonus: 0.06
  # Phase 17 · 智能排版策略引擎（LSE）
  # 默认 enabled=false：行为与 P16 末态完全一致（现网主路径，AC-P17-01）。
  # W3a 前请勿在生产打开；Studio GET /__travelogue/config 会暴露 strategyEngine.enabled 只读状态。
  # 受控 parity：PYTHONHASHSEED=0 + strategy_engine.enabled=true 须与 false 逻辑等价（纯收敛，无 CAP）。
  strategy_engine:
    enabled: false  # 保持 false 直至 W3a 切引擎评审通过
    default_strategy_id: lse-default-2026-06
    policy_path: travelogue/layout_engine/lse_policy.yaml
    runtime_store: data/lse_runtime.json
    overrides:
      disable_stages: []
      disable_profiles: []
    telemetry:
      emit_per_window: true
      decision_log_max_events: 2000
    feedback:
      enabled: true
      log_path: null
    capabilities:
      # 也可在 Studio 可视化开关：http://127.0.0.1:8766/lse-flags-admin（见 docs/PRD-智能排版开关页.md）
      saliency_scoring: false
      beat_profile: flat
      tone_harmony: false
      hungarian_assignment: false
      segment_order_optimizer: false
      implicit_feedback_export: false
      pace_profile: false
      highlight_windows: false
      editorial_hints: false
  # 智能排版 V2（ADR-002）；enabled=false 时与 legacy 完全等价
  scoring:
    enabled: false
    beam_width: 3
    # AAD-20 PrefixBeam（真前缀搜索）；默认关 = 现行 VariantRerank
    prefix_beam_enabled: false
    max_screens_per_chapter: 12
    min_layout_eligible: 3
    min_aspect_kinds: 1
    search_timeout_ms: 2000
    max_candidates_per_bucket: 12
    max_evaluations_per_trip: 500
    allow_burst_split: false
    subject_run_tolerance: 1
    skip_duplicate_signatures: true
    weights:
      aspect_match: 0.0
      sharpness: 0.0
      hero_separation: 0.0
      temporal_coherence: 0.0
      diversity: 0.0
      arc_fit: 0.0
      burst_integrity: 0.0
      luminance_continuity: 0.0
      subject_run: 0.0
      # Phase 12 · 语义连续性（默认关闭，灰度后启用）
      category_coherence: 0.0
  feedback:
    enabled: false
    log_path: null
  # URO · 模板 usage 语义硬过滤（默认关；开：enabled: true）
  usage_rules:
    enabled: false
    hero_gap_threshold: 0.15
    hero_gap_prefer_threshold: 0.15   # 与 threshold 相等 → 关闭 UT-01 edge；需 edge 改 0.22
    tiebreak_enabled: true            # false → UT-01～04 不生效
    log_rejections: true
    disabled_rules: []              # 例：["UR-04"] 禁用单条规则
  # Phase 16 · 布局模板引擎（LTE）
  template_engine:
    enabled: true
    read_templates_from_lte: true
    max_mosaic_slots: 9
    exclude_collage_from_mosaic: true
    telemetry:
      emit_per_template: true
      registry_versions_max: 8
    # MCS 章内候选多样性（覆盖 lte_policy.yaml 同路径 · PRD §9.4）
    mcs_integration:
      scoring:
        diversity:
          mode: mmr   # off | mmr | dpp
          lambda: 0.65
    # 不改 YAML 即可零曝光某 pattern（AC-P16-13）
    overrides:
      disable:
        - screen-mosaic-5-2p3l-equal
      # - screen-portrait-3

# 旅行主角二人 · 同框识别（需 vision + trip.intent.featuredSubjects + seed 正脸照）
# trip.json intent 示例：
#   featuredSubjects:
#     - id: alice
#       label: 小明
#       seedAssetIds: [a1, a2]
#     - id: bob
#       label: 小红
#       seedAssetIds: [b1, b2]
# cohort:
#   enabled: true
#   match_threshold: 0.78
#   min_face_area_ratio: 0.012
#   layout_weight: 0.06    # curate/beam 注入 cohort_coherence
#   mosaic_weight: 0.05    # 章内 mosaic hook + replan 同框加权
# Studio API（需 cohort.enabled）:
#   GET  /__travelogue/trips/{tripId}/cohort
#   PATCH /__travelogue/trips/{tripId}/cohort  { featuredSubjects, refresh }
#   POST /__travelogue/trips/{tripId}/cohort/refresh

# Phase 15 · 拼图 MCS（无用户期默认全开；PRD 亦写作 layout.mosaic_v2，顶层 mosaic 优先）
mosaic:
  enabled: true
  scorer_version: "p15-s3"
  # deterministic_strict 优先级（运行时 mosaic/trip.py::compose_trip）：
  # mosaic.enabled=true → 使用本段 mosaic.deterministic_strict；
  # mosaic.enabled=false → 回退 clustering.deterministic_strict（见下方 clustering 段）。
  deterministic_strict: true
  min_candidate_score: 0.35
  enabled_window_sizes: [4, 5, 6, 9]
  unified_mode: true
  fallback_to_legacy: true
  candidate_top_k: 4
  log_level: window
  # LTN C7 / R-E3 · size=3 MCS aux is OFF by default (parity/tiler keep explicit 3).
  # Product tracks (curated / archive / quick_share) are NOT separate YAML blocks:
  # resolve_mosaic_track(kept, intent.mode) overlays MosaicConfig at curate time.
  # Defaults & knobs: travelogue/layout_contract/mosaic_track.py + PRD §11 / §11.1.
  # Weekly board (R-E2, read-only): python scripts/ltn_weekly_dashboard.py
  enable_size3_aux: false
  density_budget:
    enabled: true
    min_slots: 4
    window_order: [5, 4, 6, 9]
    large_mosaic_min_slots: 5
    max_per_template_per_trip: 2
    max_large_mosaic_per_chapter: 1
  self_heal:
    enabled: true
    allow_drop: false
  # TPC · unified template contract (PRD-TEMPLATE-CONTRACT-V1)
  # 仓库默认保持 false（AC-TPC-01）。本机手测请见：
  #   docs/config-tpc-dogfood.example.yaml
  #   docs/acceptance-records/tpc-local-dogfood-GUIDE.md
  template_contract:
    enabled: false
    shadow_log: true
  # MTSO · experimental template dogfood (orthogonal to template_contract).
  # Default false; empty cohort ⇒ nobody. See docs/config-mtso-experiments-dogfood.example.yaml
  template_experiments:
    enabled: false
    allowlist: []
    cohort_trip_ids: []
  # MTSO · selection optimization (PR-B/C1 landed; default off until M3 / O-2).
  # Nested: hero_six_opportunity / mixed_hero_routing (inert when parent false).
  selection_optimization:
    enabled: false
  weights:
    aspect_match: 0.20
    sharpness: 0.15
    hero_separation: 0.10
    temporal_coherence: 0.15
    subject_run: 0.10
    layout_rhythm: 0.10
    diversity: 0.10
    category_coherence: 0.10
  penalties:
    face_crop: 0.30
    main_quality: 0.25
    duplicate_density: 0.20
    flat_nine_grid: 0.45
    dense_without_hero: 0.25
    # LTN C8 · D-03 slot-role
    main_not_window_best: 0.4
    main_clone_in_sidebar: 0.3
    main_area_ratio: 0.35

# --- Phase-3a 智能排版（beam 护栏 + 自适应叙事弧 + 亮度/主题 run）---
# layout:
#   scoring:
#     enabled: true
#     beam_width: 3
#     search_timeout_ms: 2000
#     max_candidates_per_bucket: 12
#     max_evaluations_per_trip: 500
#     allow_burst_split: false
#     subject_run_tolerance: 1
#     weights:
#       aspect_match: 0.13
#       sharpness: 0.05
#       temporal_coherence: 0.10
#       burst_integrity: 0.08
#       diversity: 0.08
#       arc_fit: 0.10
#       hero_separation: 0.06
#       luminance_continuity: 0.06
#       tone_continuity: 0.08
#       subject_run: 0.05
# curate:
#   arc_mode: v2_adaptive

# 已有 trip 补写色彩指标（不重新 ingest）：
#   python scripts/backfill_color_metrics.py mao linzhi

ingest:
  sharpness_version: v2   # v1 | v2（默认 v2 Laplacian + ROI）
  exif_camera: true       # Phase 23 · 写入 assets[].exif（moment-screen 脚注）
  max_photos: 250
  max_videos: 3
  max_video_source_sec: 15
  # WebP 多档（长边）；3200 供 screens 全屏大图 + Retina。回退：改回 [800, 1600, 2400] 并 re-export。
  webp_widths: [800, 1600, 2400, 3200]
  webp_quality: 82
  generate_crops: false
  min_edge_px: 320
  phash_threshold: 8
  burst_seconds: 3.0
  dedupe_phash: true
  dedupe_burst: true
  # 策展时剔除明显低于本批中位分辨率的照片（仍保留在 trip.json，不参与版面/封面）
  min_long_edge_layout_px: 800
  min_short_edge_layout_px: 600
  low_res_median_ratio: 0.55      # 相对阈值：短边 ≥ 中位短边 × 此比例
  low_res_min_megapixels: 0.8     # 相对阈值：百万像素下限（与 mp_ratio 取较大）
  low_res_mp_ratio: 0.45         # 相对阈值：像素面积 ≥ 中位 MP × 此比例
  low_res_circuit_breaker_ratio: 0.25
  low_res_circuit_breaker_median_short_px: 1200
  max_video_clip_mb: 1.5
  max_zip_mb: 25
  # 人脸检测（需 pip install -e ".[vision]"）；用于人物竖图免拼图、焦点
  detect_faces: true
  portrait_analyze: true
  face_min_size_px: 48
  # PRD-PIPELINE-PERF-V1 · R1.3（E-B）：默认 1024；回退设 0=原图检测
  face_detect_max_edge: 1024
  featured_dir_names: ["主图上传", "精选", "featured", "hero"]
  material_dir_names: ["素材上传", "素材", "material", "extras"]
  warn_featured_count_above: 30
  # PRD-PIPELINE-PERF-V1 · R1.4（E-B）：默认 2；回退设 4（Phase7 旧默认）
  webp_method: 2
  # Full product contract; ingest 只写 webp_ingest_widths，其余由 materialize 补齐
  webp_widths: [800, 1600, 2400, 3200]
  webp_ingest_widths: [800, 1600]
  shared_color_thumb_px: 32
  reject_raw: true

# Phase 9 · 排版前照片筛选（见 docs/PRD-PHASE9.md）
cull:
  enabled: true
  mode: rules                 # W1 默认 rules；W2 后可改 auto
  keep_ratio_floor: 0.90
  min_keep: 15
  # Phase 12 · 分支化评分（默认保守）
  portrait_quality_enabled: true
  face_ratio_portrait_min: 0.15
  face_ratio_gray_low: 0.10
  face_ratio_gray_high: 0.20
  score_branch_weight_portrait: 0.15
  score_branch_weight_landscape: 0.15
  portrait:
    enabled: true
    min_confidence: 0.35
    bbox_pad_ratio: 0.20
    subject_clarity_weights:
      face_sharp: 0.40
      eyes: 0.30
      frontal: 0.15
      base: 0.15
    subject_clarity_penalty_cap: 0.20
  featured_exempt: true
  featured_hard_exclude: false
  featured_exempt_low_res: true
  max_photos_warn_only: true
  sharpness_absolute_min: 0.0
  blur_percentile: 2
  # M4 · 分桶 blur 阈值（按 mediaClass 计算阈值，减少单阈值误伤）
  bucketed_blur_thresholds: false
  bucketed_blur_min_samples: 3
  hard_exclude_media_classes: [screenshot, thumbnail, reupload]
  # P9.2 · material-only 组在重算场景可启严格收敛（默认 false 保持现有行为）
  recalc_strict_groups: false
  # M6 · 为被剔除资产写质量闸口解释字段 quality.cullExplain
  enable_cull_explain: true
  # P9.2 · Pass3 score 权重（默认值与当前基线等价）
  score:
    rules:
      sharpness_weight: 0.55
      media_weight: 0.25
    ml:
      sharpness_weight: 0.35
      aesthetic_weight: 0.35
      media_weight: 0.20
      bias: 0.10
    # Phase 12 · 阈值/Top-K（默认关闭，不改变 P9 floor 语义）
    threshold: 0.0
    topk_ratio: 1.0
    # M5 · 同组非代表的轻惩罚（0=关闭）
    duplicate_group_penalty: 0.0
  ml:
    aesthetic_metric: topiq_nr
    portrait_face_aesthetic: true
    allow_cpu_ml: false
    device: auto

# Phase 7 · 流水线并行（见 docs/PRD-PHASE7.md）
# PRD-PIPELINE-PERF-V1 · deferred_derivatives：ingest 预览档 + 选片后物化
pipeline:
  parallel_embed: true
  parallel_embed_chunk: 32
  deferred_derivatives: true

vision:
  enabled: false                   # true | false | auto — P3-Full CLIP (M13)
  autoMinPhotos: 80
  autoMinEligibleRatio: 0.60
  provider: none                   # none | heuristic | clip
  model: ViT-B/32
  max_tags_per_asset: 5
  # Phase 7 · CLIP 加速
  batch_size: 16
  session_singleton: true
  prefer_web_derivative: true
  preload_on_folder_pick: true
  batch_auto_tune: true
  dynamic_backoff: true

# Phase 3 · Curate 聚类 (M12 P3-Lite / M13 P3-Full)
clustering:
  enabled: auto                    # true | false | auto
  autoGpsMinRatio: 0.40
  segmentCurateMode: event_first   # event_first | date_fallback
  sceneClusterMode: run_aware      # run_aware | off
  deterministic: true
  # 仅当 mosaic.enabled=false 时生效；mosaic 开启时见 mosaic.deterministic_strict（见 compose_trip）。
  deterministic_strict: false      # Phase 7 · 强确定性（测试/fixture）
  cache_abi_version: v1            # Phase 7 · cache ABI
  forceRecluster: false            # true → 删 cache 全量重算 (F-CLU-CACHE-03)
  geo:
    eventGapMode: auto              # auto | fixed (Phase 6)
    eventTimeGapHours: 4            # fallback when auto fails or mode=fixed
    minPhotosPerEvent: 3
    locationProximityKm: 5.5
    mergeTimeGapHours: 36
    mergeLocationKm: 55
    maxEventDays: 4
  scene:
    algorithm: hdbscan              # hdbscan | dbscan (Phase 6)
    clusterEps: 0.07              # used by dbscan fallback
    clusterMinSamples: 10
    timeoutSec: 480
  enableSceneSubSegments: true     # Geo×Scene 子分段 (P6-F1)
  sceneSubsegmentMinPhotos: 3

preview:
  width: 1080
  height: 1920
  jpeg_quality: 88

# 阅读体验 profile 默认（PRD-EXPERIENCE · 见 docs/experience-matrix.yaml）
render:
  reading:
    default_profile: default_hybrid
    share_profile: performance
    mobile_profile: legacy
    longshot_surface_profile: performance

export:
  max_zip_mb: 25
  preview_width: 1080
  strip_exif: true

narrative:
  tone_default: relaxed
  max_auto_fix_retries: 2
  # frame: 仅 hook+epilogue | frame_chapters: +首末章 lead | full: +全章 lead + 图注
  scope: frame
  banned_phrases:
    - 综上所述
    - 值得一提的是
    - 美不胜收
    - 令人难忘
  # Phase 11 · decorLine
  # Lite Copy v1.1 · 默认开启 AI 点缀（hook + decorLine + epilogue）；图注仍受 scope 控制
  copy_generation_enabled: true
  show_hook_in_draft: true
  decor_line_enabled: true
  decor_line_max_chars: 30
  decor_line_candidates: 3
  decor_line_allow_empty: true
  decor_line_intent_enabled: true
  decor_line_intent_optional: true
  decor_line_intent_note_max_chars: 30
  decor_line_min_fact_count: 2
  decor_line_voice_first: true
  decor_line_llm_enabled: true
  decor_line_visual_facts_enabled: true

# Phase 4 · Studio 工作台（M17 G1）
studio:
  # false（默认）= 模式 A：导入后自动 structure_locked 并继续 narrate/render
  # true = 模式 B：curate 后停 structure_draft，预览内确认后再继续
  g1_confirm_structure: false
  # Phase 14 · 双模式导入（开发联调开关）
  import_dual_mode_enabled: true
  # Phase 14 · 成功页分层默认动作（开发联调开关）
  success_refined_default_enabled: true
  # Phase 14 · 放大导入弹窗（开发联调开关）
  import_sheet_large_enabled: true
  # Phase 16 · LTE internal 模板目录（AC-P16-14）；loopback 默认可见
  layout_templates_internal: false
  # Longshot 2.0 · 平台化导出（PRD-LONGSHOT-2.0 §13）
  # 开发期默认开放朋友圈 + 小红书；Ins/微博/抖音仍仅 CLI
  longshot2:
    enabled: true
    platforms: [wechat_moments, xiaohongshu]
    smart_crop:
      enabled: false              # 实验裁切 · 默认关
  # Output Recipe V1 · Band × Intent → 导出配方（默认关，灰度开启）
  output_recipe:
    enabled: false
    bands:
      sparse_max: 9
      ambiguous_max: 30
      narrative_chapter_hint_at: 50

# Phase 6 · 验收阈值与运营告警（PRD-PHASE6 §18）
phase6:
  ac:
    clusterNoiseRatioDropPct: 15.0
    eventBoundaryF1LiftPct: 10.0
    layoutRepeatStreakDropPct: 25.0
    pipelineTimeRegressionPct: 10.0
    peakMemoryRegressionPct: 15.0
    coverBlindReviewWinratePct: 60.0
  alerts:
    exportSuccessRateMin: 0.97
    pipelineTimeRegressionAlertPct: 15.0
    coverPreferenceWinrateMin: 0.50
  # G1 10% 灰度门控（默认 off；放量时见 docs/config-phase6-g1.example.yaml）
  rollout:
    stage: off                  # off = 无分桶灰度，全员 P6；G1/G2/G3 = 按 trafficPercent 分桶
    trafficPercent: 0           # stage=off 时忽略；G* 时为 cohort 入组比例 0..100
    cohortSalt: travelogue-p6   # tripId + salt 稳定分桶 0..99
    allowlistTripIds: []        # 强制纳入 Phase 6 行为
    blocklistTripIds: []        # 强制回退 P5-stable 行为

# Phase 13 · 模板路由（PRD-PHASE13 §9）
template_router:
  enabled: true
  default_template: visual-journal
  confidence_threshold: 0.65
  allow_manual_override: true
  allowed_templates:
    - visual-journal
    # - event-recap   # W4 试点上线后取消注释
  beta_allowlist_trip_ids: []
  # 创建页下拉排序（AC-P13-11）
  display_order:
    - visual-journal
    - event-recap
  # 迁移 Shadow：仅记录路由、不改渲染（默认 false）
  shadow_mode: false
  # 发现排序：recommended | alphabetical | category | latest | popular | team
  discovery_sort_mode: recommended

# Phase 13 · 模板管理后台 API 权限
template_admin:
  default_role_loopback: template_admin
  require_role_on_lan: true
  # LAN：忽略 X-Template-Role，仅认 config 中 lan_role + X-Studio-Token
  lan_role: template_operator
  # 生产 / --allow-lan 建议 true
  require_token_on_loopback: false
  trust_client_role_header: true
