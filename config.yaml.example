# Travelogue 本地配置样例
# 复制为 config.yaml 并勿提交到 Git
#
# 说明：config.py 读取 trips_dir / ingest / layout / export / vision / narrative / llm。
# ffmpeg / geocode 段：geocode.enabled 已接入 ingest（Nominatim + 本地缓存）；ffmpeg 仍为规划预留。

trips_dir: ./trips

llm:
  provider: deepseek          # stub | deepseek | dashscope
  model: deepseek-chat
  api_key_env: DEEPSEEK_API_KEY  # 密钥写在项目根 .env（见 .env.example），或系统环境变量
  timeout_sec: 120
  # 百炼对照：
  # provider: dashscope
  # model: qwen-plus
  # api_key_env: DASHSCOPE_API_KEY

# --- 规划预留（未接入 runtime）---
ffmpeg:
  path: ffmpeg

geocode:
  enabled: false
  provider: null
  api_key_env: null

curate:
  segment_gap_days: 14
  city_gap_days: 3
  min_bucket_size: 3
  # legacy | v2_adaptive | v2_five_beat — 叙事弧（ADR-002 Phase 3a，默认 legacy）
  arc_mode: legacy
  arc_flat_variance_threshold: 0.08

# Web 排版引擎：legacy（media-row）| screens（16:9 舞台）；exportLayout=web|auto 宽屏时生效
layout:
  web_layout_engine: screens
  # 组屏范围：day=按策展日桶时间序全序列；chapter=仅章内 items 顺序
  screen_plan_scope: day
  # 1 竖 + 2 横混排时三张图 takenAt 最大跨度（秒）
  mixed_proximity_seconds: 12
  # 智能排版 V2（ADR-002）；enabled=false 时与 legacy 完全等价
  scoring:
    enabled: false
    beam_width: 3
    max_screens_per_chapter: 12
    min_layout_eligible: 3
    min_aspect_kinds: 1
    search_timeout_ms: 2000
    max_candidates_per_bucket: 12
    max_evaluations_per_trip: 500
    allow_burst_split: false
    subject_run_tolerance: 1
    skip_duplicate_signatures: true
    weights:
      aspect_match: 0.0
      sharpness: 0.0
      hero_separation: 0.0
      temporal_coherence: 0.0
      diversity: 0.0
      arc_fit: 0.0
      burst_integrity: 0.0
      luminance_continuity: 0.0
      subject_run: 0.0
      # Phase 12 · 语义连续性（默认关闭，灰度后启用）
      category_coherence: 0.0
  feedback:
    enabled: false
    log_path: null

# --- Phase-3a 智能排版（beam 护栏 + 自适应叙事弧 + 亮度/主题 run）---
# layout:
#   scoring:
#     enabled: true
#     beam_width: 3
#     search_timeout_ms: 2000
#     max_candidates_per_bucket: 12
#     max_evaluations_per_trip: 500
#     allow_burst_split: false
#     subject_run_tolerance: 1
#     weights:
#       aspect_match: 0.13
#       sharpness: 0.05
#       temporal_coherence: 0.10
#       burst_integrity: 0.08
#       diversity: 0.08
#       arc_fit: 0.10
#       hero_separation: 0.06
#       luminance_continuity: 0.06
#       tone_continuity: 0.08
#       subject_run: 0.05
# curate:
#   arc_mode: v2_adaptive

# 已有 trip 补写色彩指标（不重新 ingest）：
#   python scripts/backfill_color_metrics.py mao linzhi

ingest:
  max_photos: 250
  max_videos: 3
  max_video_source_sec: 15
  # WebP 多档（长边）；3200 供 screens 全屏大图 + Retina。回退：改回 [800, 1600, 2400] 并 re-export。
  webp_widths: [800, 1600, 2400, 3200]
  webp_quality: 82
  generate_crops: false
  min_edge_px: 320
  phash_threshold: 8
  burst_seconds: 3.0
  dedupe_phash: true
  dedupe_burst: true
  # 策展时剔除明显低于本批中位分辨率的照片（仍保留在 trip.json，不参与版面/封面）
  min_long_edge_layout_px: 800
  min_short_edge_layout_px: 600
  low_res_median_ratio: 0.55      # 相对阈值：短边 ≥ 中位短边 × 此比例
  low_res_min_megapixels: 0.8     # 相对阈值：百万像素下限（与 mp_ratio 取较大）
  low_res_mp_ratio: 0.45         # 相对阈值：像素面积 ≥ 中位 MP × 此比例
  low_res_circuit_breaker_ratio: 0.25
  low_res_circuit_breaker_median_short_px: 1200
  low_res_peak_ratio: 0.42       # 已废弃（长边 peak 易误伤）；保留键以兼容旧配置
  max_video_clip_mb: 1.5
  max_zip_mb: 25
  # 人脸检测（需 pip install -e ".[vision]"）；用于人物竖图免拼图、焦点
  detect_faces: true
  face_min_size_px: 48
  featured_dir_names: ["主图上传", "精选", "featured", "hero"]
  material_dir_names: ["素材上传", "素材", "material", "extras"]
  warn_featured_count_above: 30
  # Phase 7 · ingest 微优化 + RAW 拦截
  webp_method: 4
  shared_color_thumb_px: 32
  reject_raw: true

# Phase 9 · 排版前照片筛选（见 docs/PRD-PHASE9.md）
cull:
  enabled: true
  mode: rules                 # W1 默认 rules；W2 后可改 auto
  keep_ratio_floor: 0.80
  min_keep: 15
  # Phase 12 · 分支化评分（默认保守）
  portrait_quality_enabled: true
  face_ratio_portrait_min: 0.15
  face_ratio_gray_low: 0.10
  face_ratio_gray_high: 0.20
  score_branch_weight_portrait: 0.15
  score_branch_weight_landscape: 0.15
  featured_exempt: true
  featured_hard_exclude: false
  featured_exempt_low_res: true
  max_photos_warn_only: true
  sharpness_absolute_min: 0.0
  blur_percentile: 2
  # M4 · 分桶 blur 阈值（按 mediaClass 计算阈值，减少单阈值误伤）
  bucketed_blur_thresholds: false
  bucketed_blur_min_samples: 3
  hard_exclude_media_classes: [screenshot, thumbnail, reupload]
  # P9.2 · material-only 组在重算场景可启严格收敛（默认 false 保持现有行为）
  recalc_strict_groups: false
  # M6 · 为被剔除资产写质量闸口解释字段 quality.cullExplain
  enable_cull_explain: true
  # P9.2 · Pass3 score 权重（默认值与当前基线等价）
  score:
    rules:
      sharpness_weight: 0.55
      media_weight: 0.25
    ml:
      sharpness_weight: 0.35
      aesthetic_weight: 0.35
      media_weight: 0.20
      bias: 0.10
    # Phase 12 · 阈值/Top-K（默认关闭，不改变 P9 floor 语义）
    threshold: 0.0
    topk_ratio: 1.0
    # M5 · 同组非代表的轻惩罚（0=关闭）
    duplicate_group_penalty: 0.0
  ml:
    aesthetic_metric: topiq_nr
    portrait_face_aesthetic: true
    allow_cpu_ml: false
    device: auto

# Phase 7 · 流水线并行（见 docs/PRD-PHASE7.md）
pipeline:
  parallel_embed: false
  parallel_embed_chunk: 32

curate:
  featured_weight: 1.35
  featured_min_for_cover_pool: 2
  # Phase 10 · food grid（见 docs/PRD-PHASE10-food-grid.md）
  enable_food_grid: true
  # Phase 10.1 · 可配置 mundane 组屏桶（默认仅 food）
  mundane_grid_buckets: [food]
  # Phase 6 · layout rhythm & diversity (M25-B)
  layout:
    enable_gravity_balance: true
    enable_mmr_diversity: true
    max_consecutive_same_pattern: 2
    longshot_mmr_lambda: 0.72
    enable_arc_breath: true

vision:
  enabled: false                   # true | false | auto — P3-Full CLIP (M13)
  autoMinPhotos: 80
  autoMinEligibleRatio: 0.60
  provider: none                   # none | heuristic | clip
  model: ViT-B/32
  max_tags_per_asset: 5
  # Phase 7 · CLIP 加速
  batch_size: 16
  session_singleton: true
  prefer_web_derivative: true
  preload_on_folder_pick: true
  batch_auto_tune: true
  dynamic_backoff: true

# Phase 3 · Curate 聚类 (M12 P3-Lite / M13 P3-Full)
clustering:
  enabled: auto                    # true | false | auto
  autoGpsMinRatio: 0.40
  segmentCurateMode: event_first   # event_first | date_fallback
  sceneClusterMode: run_aware      # run_aware | off
  deterministic: true
  deterministic_strict: false      # Phase 7 · 强确定性（测试/fixture）
  cache_abi_version: v1            # Phase 7 · cache ABI
  forceRecluster: false            # true → 删 cache 全量重算 (F-CLU-CACHE-03)
  geo:
    eventGapMode: auto              # auto | fixed (Phase 6)
    eventTimeGapHours: 4            # fallback when auto fails or mode=fixed
    minPhotosPerEvent: 3
    locationProximityKm: 5.5
    mergeTimeGapHours: 36
    mergeLocationKm: 55
    maxEventDays: 4
  scene:
    algorithm: hdbscan              # hdbscan | dbscan (Phase 6)
    clusterEps: 0.07              # used by dbscan fallback
    clusterMinSamples: 10
    timeoutSec: 480
  enableSceneSubSegments: true     # Geo×Scene 子分段 (P6-F1)
  sceneSubsegmentMinPhotos: 3

preview:
  width: 1080
  height: 1920
  jpeg_quality: 88

# 阅读体验 profile 默认（PRD-EXPERIENCE · 见 docs/experience-matrix.yaml）
render:
  reading:
    default_profile: default_hybrid
    share_profile: performance
    mobile_profile: legacy
    longshot_surface_profile: performance

export:
  max_zip_mb: 25
  preview_width: 1080
  strip_exif: true

narrative:
  tone_default: relaxed
  max_auto_fix_retries: 2
  # frame: 仅 hook+epilogue | frame_chapters: +首末章 lead | full: +全章 lead + 图注
  scope: frame
  banned_phrases:
    - 综上所述
    - 值得一提的是
    - 美不胜收
    - 令人难忘

# Phase 4 · Studio 工作台（M17 G1）
studio:
  # false（默认）= 模式 A：导入后自动 structure_locked 并继续 narrate/render
  # true = 模式 B：curate 后停 structure_draft，预览内确认后再继续
  g1_confirm_structure: false
  # Phase 14 · 双模式导入（开发联调开关）
  import_dual_mode_enabled: true
  # Phase 14 · 成功页分层默认动作（开发联调开关）
  success_refined_default_enabled: true
  # Phase 14 · 放大导入弹窗（开发联调开关）
  import_sheet_large_enabled: true

# Phase 6 · 验收阈值与运营告警（PRD-PHASE6 §18）
phase6:
  ac:
    clusterNoiseRatioDropPct: 15.0
    eventBoundaryF1LiftPct: 10.0
    layoutRepeatStreakDropPct: 25.0
    pipelineTimeRegressionPct: 10.0
    peakMemoryRegressionPct: 15.0
    coverBlindReviewWinratePct: 60.0
  alerts:
    exportSuccessRateMin: 0.97
    pipelineTimeRegressionAlertPct: 15.0
    coverPreferenceWinrateMin: 0.50
  # G1 10% 灰度门控（默认 off；放量时见 docs/config-phase6-g1.example.yaml）
  rollout:
    stage: off                  # off = 无分桶灰度，全员 P6；G1/G2/G3 = 按 trafficPercent 分桶
    trafficPercent: 0           # stage=off 时忽略；G* 时为 cohort 入组比例 0..100
    cohortSalt: travelogue-p6   # tripId + salt 稳定分桶 0..99
    allowlistTripIds: []        # 强制纳入 Phase 6 行为
    blocklistTripIds: []        # 强制回退 P5-stable 行为

# Phase 13 · 模板路由（PRD-PHASE13 §9）
template_router:
  enabled: true
  default_template: visual-journal
  confidence_threshold: 0.65
  allow_manual_override: true
  allowed_templates:
    - visual-journal
    # - event-recap   # W4 试点上线后取消注释
  beta_allowlist_trip_ids: []
  # 创建页下拉排序（AC-P13-11）
  display_order:
    - visual-journal
    - event-recap
  # 迁移 Shadow：仅记录路由、不改渲染（默认 false）
  shadow_mode: false
  # 发现排序：recommended | alphabetical | category | latest | popular | team
  discovery_sort_mode: recommended

# Phase 13 · 模板管理后台 API 权限
template_admin:
  default_role_loopback: template_admin
  require_role_on_lan: true
  # LAN：忽略 X-Template-Role，仅认 config 中 lan_role + X-Studio-Token
  lan_role: template_operator
  # 生产 / --allow-lan 建议 true
  require_token_on_loopback: false
  trust_client_role_header: true
