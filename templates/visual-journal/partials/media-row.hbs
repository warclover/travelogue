<figure class="media-row{{#if rowClass}} {{rowClass}}{{/if}}" data-block="media-row"{{#if rowLayout}} data-row-layout="{{rowLayout}}"{{/if}}{{#if layoutHint}} data-layout-hint="{{layoutHint}}"{{/if}}{{#if hasGroupId}} data-group-id="{{groupId}}"{{/if}}{{#if preserveGroup}} data-preserve-group="true"{{/if}}>
  {{#if hasGroupMark}}
  <div class="media-row__group-mark" aria-label="{{groupMark}}">{{groupMark}}</div>
  {{/if}}
  {{#each cells}}
  <div class="media-card__frame" data-aspect-kind="{{aspectKind}}">
    <img class="media-card__visual"
      src="{{src}}"
      {{#if hasSrcset}}
      srcset="{{srcset}}"
      sizes="{{sizes}}"
      {{/if}}
      alt="{{alt}}"
      loading="lazy"
      decoding="async" />
  </div>
  {{/each}}
  {{#if hasCaption}}
  <p class="media-row__caption"{{#if editable}} data-editable="caption"{{#if editPathCaption}} data-edit-path="{{editPathCaption}}"{{/if}}{{/if}}>{{caption}}</p>
  {{/if}}
</figure>
