<div class="screenplay-toolbar" data-block="screenplay-toolbar" role="complementary" aria-label="浏览工具">
  <div class="screenplay-toolbar__fab-row">
    {{#if includeScreenplay}}
    <button type="button" id="screenplay-start" class="screenplay-toolbar__btn"
      aria-pressed="false"
      data-screenplay-label="放映"
      data-screenplay-busy="退出放映">
      放映
    </button>
    {{#if hasFeaturedAssets}}
    <button type="button" id="featured-present-toggle" class="screenplay-toolbar__btn screenplay-toolbar__btn--secondary"
      aria-pressed="false"
      data-label-on="精选放映"
      data-label-off="全部放映"
      title="仅放映 userTier: featured 的屏（保持原顺序）">
      精选放映
    </button>
    {{/if}}
    {{/if}}
    <button type="button" id="photos-only-toggle" class="screenplay-toolbar__btn screenplay-toolbar__btn--secondary"
      aria-pressed="false"
      data-label-on="纯照片"
      data-label-off="显示文案"
      title="一键隐藏全部文案">
      纯照片
    </button>
    <button type="button" id="copy-display-toggle" class="screenplay-toolbar__btn screenplay-toolbar__btn--secondary copy-toggle-advanced"
      aria-pressed="false"
      hidden
      data-copy-label-hide="隐藏导语"
      data-copy-label-show="显示导语"
      title="隐藏 hook、章导语、结语（保留图注）">
      隐藏导语
    </button>
    {{#if includeLongshotBridge}}
    <button type="button" id="longshot-bridge" class="screenplay-toolbar__btn screenplay-toolbar__btn--longshot"
      title="使用手机版竖向排版生成 PNG，可先选 2×/3× 清晰度">
      保存长图
    </button>
    {{/if}}
  </div>
  <p class="screenplay-toolbar__hint">{{#if includeScreenplay}}全屏 · 逐屏 · ←→ 翻页 · {{/if}}{{#if presentPreviewUrl}}<a class="screenplay-toolbar__link" href="{{presentPreviewUrl}}">放映预览</a> · {{/if}}文案可切换{{#if isDraft}} · 点击文案可编辑{{/if}}{{#if includeLongshotBridge}} · 长图可选 2×/3×{{/if}}</p>
</div>
{{#if includeScreenplay}}
<div id="screenplay-root" class="screenplay-root" hidden aria-hidden="true">
  <div class="screenplay-stage">
    <div class="screenplay-slide" data-screenplay-layer="a"></div>
    <div class="screenplay-slide" data-screenplay-layer="b"></div>
  </div>
  <div class="screenplay-chrome">
    <div class="screenplay-chrome__nav" hidden>
      <button type="button" class="screenplay-chrome__nav-btn" data-screenplay-action="prev" aria-label="上一屏">‹</button>
      <button type="button" class="screenplay-chrome__nav-btn" data-screenplay-action="pause" aria-label="暂停/继续"
        data-label-pause="暂停" data-label-play="继续">暂停</button>
      <button type="button" class="screenplay-chrome__nav-btn" data-screenplay-action="next" aria-label="下一屏">›</button>
    </div>
    <div class="screenplay-progress" aria-hidden="true">
      <span class="screenplay-progress__bar"></span>
    </div>
    <span class="screenplay-counter" aria-live="polite"></span>
    <button type="button" class="screenplay-chrome__stop" data-screenplay-action="stop">
      退出
    </button>
  </div>
</div>
{{/if}}
