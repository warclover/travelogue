<section
  class="cover-closing{{#unless hasClosingHero}} cover-closing--no-hero{{/unless}}{{#if closingQuiet}} cover-closing--quiet{{/if}}"
  data-block="cover-closing"
  data-cover-closing="on"
  {{#if closingQuiet}}data-cover-closing-style="colophon-quiet"{{else}}data-cover-closing-style="colophon-default"{{/if}}
>
  {{#if hasClosingHero}}
  {{> closing-hero}}
  {{else}}
  {{!-- BE-SR-06 / D-SR-04 · 封底省略不写读者可见文案；降级态仅无无 hero 版式 --}}
  {{/if}}
  <div class="cover-closing__panel">
    <span class="cover-closing__label">辑封</span>
    {{#if useEpilogueStats}}
    <p class="cover-closing__stats">{{epilogueStats.summaryLine}}</p>
    {{/if}}
    {{#if epilogue}}
    <p class="cover-closing__text epilogue" data-block="epilogue" data-present-aux="true"{{#if editableEpilogue}} data-editable="epilogue" data-edit-path="epilogue"{{/if}}>{{epilogue}}</p>
    {{/if}}
    {{#if showClosingTitle}}
    <p class="cover-closing__title" aria-hidden="true">{{title}}</p>
    {{/if}}
    {{#if showWorksBrand}}
    <p class="cover-closing__brand{{#if worksBrandCustom}} cover-closing__brand--custom{{/if}}">{{worksBrandLine}}</p>
    {{/if}}
    <p class="footer-cta__studio-home cover-closing__studio-home" hidden>
      <a class="footer-cta__studio-home-link" href="/">← 返回 Studio 首页</a>
    </p>
  </div>
  <span class="cover-closing__end" aria-hidden="true">THE END</span>
</section>
