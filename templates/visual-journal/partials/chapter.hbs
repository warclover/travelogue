<section class="chapter{{#if isAppendix}} chapter--appendix{{/if}}{{#if hideChapterChrome}} chapter--folio-body{{/if}}" id="{{id}}" data-chapter-id="{{id}}" data-pattern="{{patternId}}"{{#if isAppendix}} data-appendix="1"{{/if}}
  {{#if hasMemoryAnchors}}data-memory-anchors="{{memoryAnchors}}"{{/if}}>
  {{#unless hideChapterChrome}}
  {{#if showDivider}}
  {{#unless useChapterSeparator}}
  {{> divider-place}}
  {{/unless}}
  {{/if}}
  {{#if useChapterSeparator}}
  {{> chapter-separator}}
  {{else}}
  <header class="chapter-header" data-block="chapter-header">
    <span class="chapter-header__index" aria-hidden="true">{{index}}</span>
    <div class="chapter-header__rule" aria-hidden="true"></div>
    <h2>{{title}}</h2>
  </header>
  {{/if}}
  {{#unless useChapterSeparator}}
  {{#if hasDecorLine}}
  <p class="chapter-decor-line" data-block="decor-line"{{#if editableDecorLine}} data-editable="decor-line" data-edit-path="{{editDecorLinePath}}"{{/if}}>{{decorLine}}</p>
  {{/if}}
  {{#if hasLead}}
  <p class="chapter-lead" data-block="chapter-lead"{{#if editableLead}} data-editable="lead" data-edit-path="{{editLeadPath}}"{{/if}}>{{lead}}</p>
  {{/if}}
  {{/unless}}
  {{/unless}}
  {{#if useScreensEngine}}
  {{#each screens}}
  {{#if isBreathPause}}
  {{> breath-pause-screen}}
  {{else}}
  {{> layout-screen}}
  {{/if}}
  {{/each}}
  {{#if hasScreenSpread}}
  {{> screen-spread screenSpread}}
  {{/if}}
  {{else}}
  {{#each items}}
  {{#if isBreathPause}}
  {{> breath-pause-card}}
  {{else}}
  {{#if isMediaCard}}
  {{> media-card}}
  {{/if}}
  {{#if isMediaRow}}
  {{> media-row}}
  {{/if}}
  {{#if isMediaScroll}}
  {{> media-scroll}}
  {{/if}}
  {{/if}}
  {{/each}}
  {{/if}}
</section>
