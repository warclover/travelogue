<section class="cover-opening" data-block="cover-opening" data-cover-opening="{{coverOpeningStyle}}">
  {{> cover-hero}}
  <div class="cover-opening__panel">
    {{#if showCoverPlace}}
    <p class="cover-opening__place">{{coverPlace}}</p>
    {{/if}}
    {{> trip-meta}}
    <h1 class="cover-opening__title" itemprop="name">{{title}}</h1>
    {{#if showCoverHook}}
    <p class="hook-line cover-opening__hook" data-block="hook-line"{{#if editableHook}} data-editable="hook" data-edit-path="meta.hook"{{/if}}>{{hook}}</p>
    {{/if}}
  </div>
</section>
