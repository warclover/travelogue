<section class="epilogue-screen epilogue" data-block="epilogue-screen" data-present-aux="true">
  <span class="epilogue-screen__label">Colophon</span>
  {{#if useEpilogueStats}}
  <p class="epilogue-screen__stats">{{epilogueStats.summaryLine}}</p>
  {{/if}}
  {{#if epilogue}}
  <p class="epilogue-screen__text"{{#if editableEpilogue}} data-editable="epilogue" data-edit-path="epilogue"{{/if}}>{{epilogue}}</p>
  {{/if}}
</section>
