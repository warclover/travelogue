<div class="moment-screen layout-screen layout-screen--moment" data-block="moment-screen" data-asset-id="{{assetId}}">
  <div class="moment-screen__stage{{#if isPortrait}} layout-screen--moment-portrait{{/if}}{{#if hasViewportFit}} layout-screen--viewport-fit{{/if}}{{#if hasTierUltra}} layout-screen--tier-ultra{{/if}}"{{#if hasScreenStyle}} style="{{screenStyle}}"{{/if}}>
    <figure class="layout-screen__grid layout-screen__grid--1col layout-screen--moment__figure">
      <span class="moment-screen__label" aria-hidden="true">{{label}}</span>
      <figure class="layout-slot layout-slot--moment" data-slot="0" data-role="main">
        <img class="layout-slot__img layout-slot__img--{{fit}}"
          src="{{src}}"
          {{#if hasSrcset}}
          srcset="{{srcset}}"
          sizes="{{sizes}}"
          {{/if}}
          alt="{{alt}}"
          style="--focal-x: {{focalX}}; --focal-y: {{focalY}};"
          loading="lazy"
          decoding="async" />
      </figure>
    </figure>
  </div>
  {{#if hasExifLine}}
  <p class="moment-exif-line">{{exifLine}}</p>
  {{/if}}
</div>
