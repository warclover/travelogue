<div class="layout-screen layout-screen--16x9{{#if hasViewportFit}} layout-screen--viewport-fit{{/if}}{{#if hasTierUltra}} layout-screen--tier-ultra{{/if}}{{#if isPlate}} layout-screen--plate{{/if}}" data-block="layout-screen" data-pattern="{{patternId}}"{{#if hasScreenIndex}} data-screen-index="{{screenIndex}}"{{/if}}{{#if hasChapterIndex}} data-chapter-index="{{chapterIndex}}"{{/if}}{{#if hasAssetIds}} data-asset-ids="{{assetIds}}"{{/if}}{{#if isFeatured}} data-featured="true"{{/if}}{{#if hasLayoutHint}} data-layout-hint="{{layoutHint}}"{{/if}}{{#if screenStyle}} style="{{screenStyle}}"{{/if}}>
  {{#if folioLite}}
  <div class="folio-plate-meta folio-plate-meta--top" aria-hidden="true">{{folioPageLabel}}</div>
  {{/if}}
  <div class="layout-screen__grid {{gridClass}}">
    {{#each slots}}
    <figure class="layout-slot{{#if hasBlurFill}} layout-slot--blurred-fill{{/if}}" data-slot="{{slotIndex}}"{{#if role}} data-role="{{role}}"{{/if}}{{#if slotStyle}} style="{{slotStyle}}"{{/if}}>
      {{#if hasBlurFill}}
      <img class="layout-slot__blur"
        src="{{blurSrc}}"
        alt=""
        aria-hidden="true"
        loading="{{loading}}"
        decoding="async" />
      {{/if}}
      {{#if hasSrc}}
      <img class="layout-slot__img layout-slot__img--{{fit}}"
        src="{{src}}"
        {{#if hasSrcset}}
        srcset="{{srcset}}"
        sizes="{{sizes}}"
        {{/if}}
        alt="{{alt}}"
        loading="{{loading}}"
        decoding="async" />
      {{/if}}
    </figure>
    {{/each}}
  </div>
  {{#if hasPlateCaption}}
  <figcaption class="plate-caption">{{plateCaption}}</figcaption>
  {{/if}}
  {{#if folioLite}}
  <div class="folio-plate-meta folio-plate-meta--bottom" aria-hidden="true">{{chapterIndex}} · {{patternId}}</div>
  {{/if}}
</div>
