<header class="cover-hero{{#unless coverShowTitle}} cover-hero--photo-only{{/unless}}{{#if cover.useContainFit}} cover-hero--contain-fit{{/if}}" data-block="cover-hero" data-present-aux="true">
  <div class="cover-hero__media" style="--focal-x: {{cover.focalX}}; --focal-y: {{cover.focalY}};">
    <img class="cover-hero__img cover-hero__img--main"
      src="{{cover.src}}"
      {{#if cover.hasSrcset}}
      srcset="{{cover.srcset}}"
      sizes="{{cover.sizes}}"
      {{/if}}
      alt="{{cover.alt}}"
      loading="eager"
      decoding="async" />
  </div>
  {{#if coverShowTitle}}
  <div class="cover-hero__overlay" aria-hidden="true"></div>
  <div class="cover-hero__text">
    <h1 itemprop="name">{{title}}</h1>
    {{#if hasSubtitle}}
    <p class="subtitle">{{subtitle}}</p>
    {{/if}}
  </div>
  {{/if}}
</header>
