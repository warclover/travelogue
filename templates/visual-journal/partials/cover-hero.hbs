<header class="cover-hero{{#unless coverShowTitle}} cover-hero--photo-only{{/unless}}" data-block="cover-hero" data-present-aux="true">
  <div class="cover-hero__media">
    <img src="{{cover.src}}"
      {{#if cover.hasSrcset}}
      srcset="{{cover.srcset}}"
      sizes="{{cover.sizes}}"
      {{/if}}
      alt="{{cover.alt}}"
      loading="eager"
      decoding="async" />
  </div>
  {{#if coverShowTitle}}
  <div class="cover-hero__overlay" aria-hidden="true"></div>
  <div class="cover-hero__text">
    <h1 itemprop="name">{{title}}</h1>
    {{#if hasSubtitle}}
    <p class="subtitle">{{subtitle}}</p>
    {{/if}}
  </div>
  {{else}}
  <h1 class="cover-hero__title-sr" itemprop="name">{{title}}</h1>
  {{/if}}
  {{#if includeScreenplay}}
  <button type="button" class="cover-hero__play" data-screenplay-trigger="start"
    data-screenplay-label="▶ 放映"
    data-screenplay-busy="退出放映"
    aria-label="放映，全屏逐屏展示">
    ▶ 放映
  </button>
  {{/if}}
</header>
