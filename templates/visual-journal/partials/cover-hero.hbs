<header class="cover-hero" data-block="cover-hero">
  <div class="cover-hero__media">
    <img src="{{cover.src}}"
      {{#if cover.hasSrcset}}
      srcset="{{cover.srcset}}"
      sizes="{{cover.sizes}}"
      {{/if}}
      alt="{{cover.alt}}"
      loading="eager"
      decoding="async" />
  </div>
  <div class="cover-hero__overlay" aria-hidden="true"></div>
  <div class="cover-hero__text">
    <h1 itemprop="name">{{title}}</h1>
    {{#if hasSubtitle}}
    <p class="subtitle">{{subtitle}}</p>
    {{/if}}
  </div>
  {{#if includeScreenplay}}
  <button type="button" class="cover-hero__play" data-screenplay-trigger="start"
    data-screenplay-label="▶ 自动播放"
    data-screenplay-busy="退出播放"
    aria-label="自动播放，全屏逐屏放映">
    ▶ 自动播放
  </button>
  {{/if}}
</header>
