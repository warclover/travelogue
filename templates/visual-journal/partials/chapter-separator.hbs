<section class="chapter-separator" data-block="chapter-separator" style="{{chapterSeparatorStyle}}">
  <span class="chapter-separator__index">{{index}}</span>
  <h2 class="chapter-separator__title">{{title}}</h2>
  {{#if hasLead}}
  <p class="chapter-separator__lead">{{lead}}</p>
  {{/if}}
</section>
