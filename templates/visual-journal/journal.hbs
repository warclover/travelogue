<!DOCTYPE html>
<html lang="{{lang}}" {{{htmlExtraAttrs}}}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{{title}}</title>
  <link rel="stylesheet" href="journal.css?v={{assetVersion}}" />
  {{#if includeLongShot}}
  <link rel="stylesheet" href="longshot.css?v={{assetVersion}}" />
  {{/if}}
</head>
<body>
  <main>
    <article itemscope itemtype="https://schema.org/Trip">
      {{> cover-hero}}
      <div class="page">
        {{> trip-meta}}
        {{#if hasHook}}
        <p class="hook-line" data-block="hook-line">{{hook}}</p>
        {{/if}}
        {{#each chapters}}
        {{> chapter}}
        {{/each}}
        {{#if hasEpilogue}}
        <p class="epilogue" data-block="epilogue">{{epilogue}}</p>
        {{/if}}
        {{> footer-cta}}
      </div>
    </article>
  </main>
  {{#if includeLongShot}}
  {{> longshot-toolbar}}
  <script src="vendor/html2canvas.min.js?v={{assetVersion}}" defer></script>
  <script src="longshot.js?v={{assetVersion}}" defer></script>
  <script src="share.js?v={{assetVersion}}" defer></script>
  {{/if}}
</body>
</html>
