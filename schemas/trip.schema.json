{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travelogue.local/schemas/trip.schema.json",
  "title": "Travelogue Trip",
  "description": "trip.json v0.2 — single source of truth for visual-journal template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "tripId",
    "templateId",
    "exportLayout",
    "meta",
    "coverAssetId",
    "assets",
    "chapters",
    "privacy",
    "pipeline",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "version": { "const": "0.2" },
    "tripId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$"
    },
    "templateId": { "const": "visual-journal" },
    "exportLayout": {
      "type": "string",
      "enum": ["auto", "mobile", "web"],
      "default": "auto"
    },
    "layoutEngine": {
      "type": "string",
      "enum": ["legacy", "screens"],
      "default": "legacy",
      "description": "Web layout: legacy (media-card/row) or screens (16:9 stage)"
    },
    "layoutEngineVersion": {
      "type": "string",
      "description": "screens engine rules version, e.g. screens-1"
    },
    "meta": { "$ref": "#/$defs/meta" },
    "coverAssetId": { "type": "string" },
    "coverCandidates": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 5
    },
    "assets": {
      "type": "array",
      "maxItems": 250,
      "items": { "$ref": "#/$defs/asset" }
    },
    "chapters": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/chapter" }
    },
    "epilogue": { "type": "string", "maxLength": 80 },
    "privacy": { "$ref": "#/$defs/privacy" },
    "pipeline": { "$ref": "#/$defs/pipeline" },
    "userNotes": { "type": "string", "maxLength": 2000 },
    "slug": { "type": ["string", "null"] },
    "publishedAt": { "type": ["string", "null"], "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "curation": { "$ref": "#/$defs/tripCuration" },
    "export": { "$ref": "#/$defs/exportOptions" }
  },
  "$defs": {
    "exportOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "longShot": {
          "type": "boolean",
          "description": "P0: include 保存长图 bundle in draft/share export (default true in renderer)"
        },
        "fontTheme": {
          "type": "string",
          "enum": ["ui", "magazine"],
          "description": "Optional HTML font theme (default ui / Microsoft YaHei stack)"
        },
        "copyDisplay": {
          "type": "string",
          "enum": ["full", "photos"],
          "description": "Render: full shows hook/lead/captions; photos hides narrative copy (trip.json unchanged)"
        },
        "breathMode": {
          "type": "string",
          "enum": ["off", "soft", "flow", "cinematic", "gallery"],
          "description": "Deprecated alias for export.reading.scroll.breath (1-version compat)"
        },
        "folioMode": {
          "type": "string",
          "enum": ["off", "lite", "full"],
          "description": "Deprecated alias for export.reading.scroll.folio (1-version compat)"
        },
        "reading": { "$ref": "#/$defs/readingOptions" }
      }
    },
    "readingOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["legacy", "performance", "default_hybrid", "magazine"],
          "description": "Reading experience preset (PRD-EXPERIENCE); expands scroll/present/longshot defaults"
        },
        "present": { "$ref": "#/$defs/readingPresent" },
        "scroll": { "$ref": "#/$defs/readingScroll" },
        "longshot": { "$ref": "#/$defs/readingLongshot" },
        "mobileProfile": {
          "type": "string",
          "enum": ["legacy", "performance", "default_hybrid", "magazine"],
          "description": "Optional profile override for index-mobile.html (P5 · ADR-003 opt-in)"
        }
      }
    },
    "readingPresent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dwellMs": { "type": "integer", "minimum": 500, "maximum": 30000 },
        "featuredOnly": { "type": "boolean" },
        "syncScrollOnExit": { "type": "boolean" },
        "skipAuxBlocks": { "type": "boolean" },
        "deepLink": {
          "type": "boolean",
          "description": "Enable URL hash #present/N deep links (P5)"
        }
      }
    },
    "readingScroll": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snap": { "type": "string", "enum": ["off", "proximity", "mandatory"] },
        "breath": {
          "type": "string",
          "enum": ["off", "soft", "flow", "cinematic", "gallery"]
        },
        "folio": { "type": "string", "enum": ["off", "lite", "full"] },
        "breathEngine": {
          "type": "string",
          "enum": ["native", "gsap"],
          "description": "Scrub engine for cinematic/gallery (P5 · gsap loads CDN when set)"
        }
      }
    },
    "readingLongshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "breath": { "type": "string", "enum": ["off"] },
        "folio": { "type": "string", "enum": ["off"] }
      }
    },
    "orientationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "landscape",
        "portrait",
        "square",
        "panorama",
        "tall",
        "export_layout"
      ],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "landscape": { "type": "integer", "minimum": 0 },
        "portrait": { "type": "integer", "minimum": 0 },
        "square": { "type": "integer", "minimum": 0 },
        "panorama": { "type": "integer", "minimum": 0 },
        "tall": { "type": "integer", "minimum": 0 },
        "export_layout": {
          "type": "string",
          "enum": ["auto", "mobile", "web"]
        }
      }
    },
    "tripCuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "orientationSummary": { "$ref": "#/$defs/orientationSummary" },
        "layoutPlanVersion": { "type": "string" },
        "layoutPlanRunId": { "type": "string" },
        "coverByLayout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mobile": { "type": "string" },
            "web": { "type": "string" }
          }
        },
        "coverCandidatesByLayout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mobile": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
            "web": { "type": "array", "items": { "type": "string" }, "maxItems": 5 }
          }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "excludedLowResAssetIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "segments": {
          "type": "array",
          "items": { "$ref": "#/$defs/timeSegment" }
        },
        "primarySegmentId": { "type": "string" },
        "mediaClassSummary": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "curatePlanVersion": { "type": "string" },
        "chapterPlan": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "chapterIndex": { "type": "integer" },
              "chapterId": { "type": "string" },
              "assetCount": { "type": "integer", "minimum": 0 },
              "daySpan": {
                "type": "array",
                "items": { "type": "string", "format": "date" }
              },
              "segmentId": { "type": "string" },
              "patternHint": { "type": "string" },
              "patternId": { "type": "string" },
              "heroAssetId": { "type": "string" }
            }
          }
        },
        "chapterHeroAssetIds": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "layoutPlanSummary": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "arcProfile": {
          "type": "object",
          "additionalProperties": true,
          "description": "Adaptive narrative arc profile (Phase 3a)"
        },
        "layoutMetrics": {
          "type": "object",
          "additionalProperties": true,
          "description": "Offline layout evaluation metrics"
        },
        "layoutDecisionLog": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "layoutSearchBudget": {
          "type": "object",
          "additionalProperties": true,
          "description": "Beam search guardrail stats"
        },
        "degradationReason": {
          "type": "string",
          "description": "Why smart layout fell back to legacy"
        },
        "narrativeScope": {
          "type": "string",
          "enum": ["frame", "frame_chapters", "full"],
          "description": "Copy generation scope used at last narrate run"
        },
        "folioPlan": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "index": { "type": "boolean" },
            "foreword": { "type": "boolean" },
            "featuredGrid": { "type": "boolean" },
            "featuredGridAssetIds": {
              "type": "array",
              "items": { "type": "string" }
            },
            "plateAssetIds": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "userTierSummary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "featured": { "type": "integer", "minimum": 0 },
            "material": { "type": "integer", "minimum": 0 },
            "featuredInLayout": { "type": "integer", "minimum": 0 }
          }
        },
        "featuredHeroByChapter": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "featuredCoverPool": {
          "type": "array",
          "items": { "type": "string" }
        },
        "clustering": { "$ref": "#/$defs/tripClustering" }
      }
    },
    "geoEventSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "startDate", "endDate", "assetIds"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 48 },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "assetIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "location": { "type": "string", "maxLength": 32 }
      }
    },
    "sceneCluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "assetIds"],
      "properties": {
        "id": { "type": "integer" },
        "label": { "type": "string", "maxLength": 32 },
        "assetIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "medoidAssetId": { "type": "string" }
      }
    },
    "tripClustering": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "const": "1" },
        "segmentMode": {
          "type": "string",
          "enum": ["geo_event", "date_fallback"]
        },
        "segments": {
          "type": "array",
          "items": { "$ref": "#/$defs/geoEventSegment" }
        },
        "clusters": {
          "type": "array",
          "items": { "$ref": "#/$defs/sceneCluster" }
        },
        "visionModel": { "type": "string" },
        "vision": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "string",
              "enum": ["clip", "heuristic"]
            },
            "model": { "type": "string" }
          }
        },
        "userSummary": {
          "type": "object",
          "additionalProperties": true,
          "description": "Derived chapter-layout explanation (Phase 3 · attach_chapter_explain)"
        }
      }
    },
    "timeSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "dateStart", "dateEnd", "assetIds"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string", "maxLength": 24 },
        "dateStart": { "type": "string", "format": "date" },
        "dateEnd": { "type": "string", "format": "date" },
        "assetIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "places": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 3
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "dateStart", "dateEnd", "places", "tone"],
      "properties": {
        "title": { "type": "string", "maxLength": 20 },
        "subtitle": { "type": "string", "maxLength": 32 },
        "hook": { "type": "string", "maxLength": 56 },
        "dateStart": { "type": "string", "format": "date" },
        "dateEnd": { "type": "string", "format": "date" },
        "places": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "companions": { "type": "string", "maxLength": 32 },
        "tone": { "type": "string", "enum": ["relaxed", "documentary"] }
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["city"],
      "properties": {
        "city": { "type": "string" },
        "country": { "type": "string", "minLength": 2, "maxLength": 2 }
      }
    },
    "focalPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "srcsetEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "width"],
      "properties": {
        "file": { "type": "string" },
        "width": { "type": "integer", "minimum": 1 }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audioFile", "transcript", "source"],
      "properties": {
        "audioFile": { "type": "string" },
        "durationSec": { "type": "number", "minimum": 5, "maximum": 180 },
        "transcript": { "type": "string", "maxLength": 4000 },
        "transcriptPreview": { "type": "string", "maxLength": 40 },
        "source": { "const": "user" },
        "showTranscript": { "type": "boolean", "default": true }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "sourceFile"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["image", "video", "audio"] },
        "sourceFile": { "type": "string" },
        "displayFile": { "type": "string" },
        "posterFile": { "type": "string" },
        "srcset": {
          "type": "array",
          "items": { "$ref": "#/$defs/srcsetEntry" }
        },
        "cropMobile": { "type": "string" },
        "cropWeb": { "type": "string" },
        "focalPoint": { "$ref": "#/$defs/focalPoint" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "nativeWidth": {
          "type": "integer",
          "minimum": 1,
          "description": "Original source pixel width before WebP upscale"
        },
        "nativeHeight": {
          "type": "integer",
          "minimum": 1,
          "description": "Original source pixel height before WebP upscale"
        },
        "takenAt": { "type": "string", "format": "date-time" },
        "place": { "$ref": "#/$defs/place" },
        "duration": { "type": "number", "minimum": 0 },
        "hasAudio": { "type": "boolean" },
        "ingestBatchId": { "type": "string" },
        "dedupeGroupId": { "type": "string" },
        "contentSig": {
          "type": "string",
          "description": "MD5 content signature (size:hex) for cross-ingest dedupe"
        },
        "locked": { "type": "boolean" },
        "tags": {
          "type": "array",
          "items": { "type": "string", "maxLength": 32 },
          "maxItems": 8,
          "description": "Semantic tags from Agent 0 vision/heuristic; 3-5 recommended"
        },
        "tagsSource": {
          "type": "string",
          "enum": ["heuristic", "exif", "clip", "vlm", "user"],
          "description": "How tags were produced"
        },
        "userTier": {
          "type": "string",
          "enum": ["featured", "material"],
          "description": "User intent from featured vs material ingest folder (PRD-EXPERIENCE appendix A)"
        },
        "userTierSource": {
          "type": "string",
          "enum": ["ingest", "user"],
          "description": "How userTier was assigned"
        },
        "importSource": {
          "type": "string",
          "enum": ["featured", "material", "legacy"],
          "description": "Original ingest folder (PRD-EXPERIENCE appendix A §3.1)"
        },
        "voice": { "$ref": "#/$defs/voice" },
        "caption": {
          "type": "string",
          "maxLength": 60,
          "description": "Per-asset caption (screens/longshot); complements chapter items[]"
        },
        "skipCaption": {
          "type": "boolean",
          "description": "When true, hide caption and skip narrate for this asset"
        },
        "aspectKind": {
          "type": "string",
          "enum": ["portrait", "landscape", "square", "panorama", "tall"],
          "description": "Composition bucket from classify_aspect (Agent 0 / layout)"
        },
        "dateSource": {
          "type": "string",
          "enum": ["exif", "filename", "mtime"]
        },
        "dateConfidence": {
          "type": "string",
          "enum": ["high", "low"]
        },
        "mediaClass": {
          "type": "string",
          "enum": ["photo", "screenshot", "thumbnail", "reupload", "archive", "unknown"]
        },
        "layoutEligible": {
          "type": "boolean",
          "description": "False when excluded from cover/chapters/screens (e.g. low resolution)"
        },
        "excludeReason": {
          "type": "string",
          "enum": ["low_resolution"]
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sharpness": { "type": "number", "minimum": 0 },
            "meanLuma": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "dominantTone": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Average tone hex for spread continuity scoring"
        },
        "salientBox": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "w", "h"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 },
            "w": { "type": "number", "minimum": 0, "maximum": 1 },
            "h": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "description": "Primary subject region (face box when detected)"
        },
        "burstGroupId": {
          "type": "string",
          "description": "Time-proximate burst cluster id from ingest"
        },
        "eventId": {
          "type": "string",
          "description": "Geo event segment id from Phase 3 clustering"
        },
        "sceneClusterId": {
          "type": "integer",
          "description": "Scene cluster label from embedding DBSCAN; -1 = noise"
        },
        "clusterSource": {
          "type": "string",
          "enum": ["clip", "heuristic"],
          "description": "Embedding source used for sceneClusterId"
        },
        "subjectBucket": {
          "type": "string",
          "description": "Heuristic subject bucket from ingest (Agent 0)"
        },
        "subjectClass": {
          "type": "string",
          "description": "CLIP zero-shot subject class (Phase 3 M13)"
        },
        "subjectConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "CLIP subjectClass confidence"
        },
        "geo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lon": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "image" } } },
          "then": { "required": ["displayFile"] }
        },
        {
          "if": { "properties": { "type": { "const": "video" } } },
          "then": { "required": ["displayFile", "posterFile", "duration"] }
        }
      ]
    },
    "mediaCardLayout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fill": { "type": "boolean" },
        "bleed": { "type": "boolean" },
        "overlay": { "type": "boolean" },
        "slot": {
          "type": "string",
          "enum": ["panorama", "square", "tall"],
          "description": "Wide/tall/square card treatment for render CSS"
        }
      }
    },
    "mediaCardItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "assetId"],
      "properties": {
        "type": { "const": "media-card" },
        "assetId": { "type": "string" },
        "title": { "type": "string", "maxLength": 14 },
        "caption": { "type": "string", "maxLength": 60 },
        "edited": { "type": "boolean" },
        "layout": { "$ref": "#/$defs/mediaCardLayout" }
      }
    },
    "mediaRowItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "assetIds", "rowLayout"],
      "properties": {
        "type": { "const": "media-row" },
        "assetIds": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "maxItems": 8
        },
        "rowLayout": {
          "type": "string",
          "enum": [
            "landscape-triple",
            "landscape-pair",
            "portrait-triple",
            "portrait-pair",
            "square-triple",
            "square-pair",
            "mobile-landscape-grid-8",
            "mobile-portrait-grid-4"
          ]
        },
        "layoutHint": {
          "type": "string",
          "enum": ["person-grid-4"]
        }
      }
    },
    "mediaScrollItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "assetIds"],
      "properties": {
        "type": { "const": "media-scroll" },
        "assetIds": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 3,
          "maxItems": 5
        },
        "caption": { "type": "string", "maxLength": 60 },
        "voice": { "$ref": "#/$defs/voice" }
      }
    },
    "chapterItem": {
      "oneOf": [
        { "$ref": "#/$defs/mediaCardItem" },
        { "$ref": "#/$defs/mediaRowItem" },
        { "$ref": "#/$defs/mediaScrollItem" }
      ]
    },
    "chapterCuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anchorAssetId": { "type": "string" },
        "daySpan": {
          "type": "array",
          "items": { "type": "string", "format": "date" }
        },
        "places": {
          "type": "array",
          "items": { "type": "string" }
        },
        "memoryAnchors": {
          "type": "array",
          "items": { "type": "string", "maxLength": 24 },
          "maxItems": 3,
          "description": "User memory hooks at G1; fed to Agent 2"
        },
        "segmentId": {
          "type": "string",
          "description": "Primary travel time segment for this chapter (most assets)"
        },
        "segmentIds": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 16,
          "description": "All segments represented when day buckets were merged across trips"
        },
        "patternHint": {
          "type": "string",
          "enum": ["open", "gallery", "moment", "close"]
        },
        "heroAssetId": { "type": "string" },
        "layoutStub": {
          "type": "boolean",
          "description": "True when items[] is a compact stub derived from screens[]"
        }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "index", "patternId", "title", "items"],
      "properties": {
        "id": { "type": "string" },
        "index": { "type": "integer", "minimum": 1, "maximum": 5 },
        "patternId": {
          "type": "string",
          "enum": ["open", "gallery", "moment", "close"]
        },
        "title": { "type": "string", "maxLength": 12 },
        "lead": { "type": "string", "maxLength": 80 },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/chapterItem" }
        },
        "screens": {
          "type": "array",
          "description": "Web layoutEngine=screens; optional when legacy",
          "items": { "$ref": "#/$defs/layoutScreen" }
        },
        "curation": { "$ref": "#/$defs/chapterCuration" }
      }
    },
    "layoutScreenSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "slot", "fit"],
      "properties": {
        "assetId": { "type": "string" },
        "slot": { "type": "integer", "minimum": 0, "maximum": 8 },
        "fit": { "type": "string", "enum": ["cover", "contain"] },
        "role": { "type": "string", "enum": ["portrait", "landscape", "main"] }
      }
    },
    "layoutScreen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screenId", "patternId", "slots"],
      "properties": {
        "screenId": { "type": "string" },
        "patternId": {
          "type": "string",
          "enum": [
            "screen-portrait-1",
            "screen-portrait-2",
            "screen-portrait-3",
            "screen-portrait-1-landscape-2",
            "screen-mosaic-5-main-portrait-3land",
            "screen-portrait-grid-8",
            "screen-portrait-4",
            "screen-portrait-6",
            "screen-portrait-9",
            "screen-landscape-1",
            "screen-landscape-2",
            "screen-landscape-3",
            "screen-landscape-4",
            "screen-landscape-6",
            "screen-landscape-9",
            "screen-square-1",
            "screen-square-2",
            "screen-square-3",
            "screen-square-4",
            "screen-square-6",
            "screen-square-9",
            "screen-panorama-1",
            "screen-tall-1"
          ]
        },
        "tone": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "r": { "type": "integer", "minimum": 0, "maximum": 255 },
            "g": { "type": "integer", "minimum": 0, "maximum": 255 },
            "b": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        },
        "layoutHint": {
          "type": "string",
          "enum": ["person-pair", "person-triple", "person-grid-8"],
          "description": "Person portrait: 2-col pair, 3-col row, or 4×2 grid (contain per slot)"
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/layoutScreenSlot" }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "stripExifOnExport", "confirmedAt"],
      "properties": {
        "level": { "type": "string", "enum": ["private", "unlisted", "public"] },
        "stripExifOnExport": { "type": "boolean" },
        "confirmedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "pipelineRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "agent", "startedAt", "finishedAt"],
      "properties": {
        "runId": { "type": "string" },
        "agent": {
          "type": "string",
          "enum": ["media_lab", "curator", "layout", "storyteller", "publisher"]
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "model": { "type": ["string", "null"] }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "locks"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft_ingest",
            "ingest_ready",
            "structure_draft",
            "structure_locked",
            "copy_draft",
            "copy_locked",
            "rendered",
            "exported"
          ]
        },
        "lastBatchId": { "type": "string" },
        "layoutStatus": {
          "type": "string",
          "enum": ["pending", "layout_draft", "layout_locked"]
        },
        "pendingAssets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "locks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["structure", "copy"],
          "properties": {
            "structure": { "type": "boolean" },
            "layout": { "type": "boolean" },
            "copy": { "type": "boolean" }
          }
        },
        "runs": {
          "type": "array",
          "items": { "$ref": "#/$defs/pipelineRun" }
        }
      }
    }
  }
}
