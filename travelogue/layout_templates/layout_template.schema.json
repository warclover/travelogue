{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travelogue.local/schemas/layout_template.schema.json",
  "title": "LayoutTemplate",
  "description": "Phase 16 layout template (LTE) authoritative YAML schema (PRD v0.16.4, R-P16-11).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "status",
    "kind",
    "displayName",
    "stage",
    "photoCount",
    "slots",
    "render"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Stable patternId written to trip.json screens[].patternId"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Template revision; topology changes bump version or new id"
    },
    "status": {
      "type": "string",
      "enum": ["experimental", "beta", "ga", "deprecated", "disabled"],
      "description": "Lifecycle aligned with travelogue.templating.lifecycle (R-P16-13)"
    },
    "kind": {
      "type": "string",
      "enum": ["primitive", "composite", "stack"],
      "description": "Template taxonomy layer (PRD §4.2)"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "aesthetic": {
      "type": "string",
      "enum": ["airy", "dense", "hero_first"]
    },
    "balancePolicy": {
      "type": "string",
      "enum": ["equal_width", "equal_height", "equal_area", "weighted_tracks"],
      "description": "Composite balance hint (PRD §4.1, R-P16-05)"
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect"],
      "properties": {
        "aspect": {
          "type": "string",
          "pattern": "^\\d+:\\d+$",
          "description": "Stage aspect ratio authority per template (D-P16-01)"
        },
        "grid": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Legacy uniform grid [cols, rows]; optional when cols/rows weights present"
        },
        "cols": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "description": "Weighted column tracks (fr); default [1]*N for uniform grid (§4.6)"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "description": "Weighted row tracks (fr); default [1]*N for uniform grid (§4.6)"
        },
        "gap": {
          "type": "string",
          "description": "CSS gap between tracks (R-P16-15); e.g. 0, 4px, var(--screen-gap)"
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["layout", "aspect"],
            "properties": {
              "layout": {
                "type": "string",
                "enum": ["web", "mobile"]
              },
              "aspect": {
                "type": "string",
                "pattern": "^\\d+:\\d+$"
              }
            }
          }
        }
      },
      "anyOf": [
        {
          "required": ["grid"]
        },
        {
          "required": ["cols", "rows"]
        }
      ]
    },
    "photoCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        }
      }
    },
    "mix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "portrait": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "landscape": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "square": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9,
          "description": "TPC bag-of-mix square count (optional)"
        }
      }
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/slot"
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "portrait_forbidden_in_wide_slots": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "landscape_forbidden_in_tall_slots": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "intentionalGaps": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer"
            }
          },
          "description": "Explicit empty grid cells (V-P16-02)"
        },
        "arLadderSignOff": {
          "type": "object",
          "description": "Manual AR ladder exemptions for main slots (V-P16-13)",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["signedBy", "signedAt"],
            "properties": {
              "signedBy": {
                "type": "string",
                "minLength": 1
              },
              "signedAt": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "mainSlotPolicy": {
          "type": "object",
          "description": "Main hero slot asset AR eligibility (V-P16-MAIN-01 · PRD-6张拼图优化). W3+: prefer constraints.eligibility; bridge until deleted.",
          "additionalProperties": false,
          "properties": {
            "slotIndex": {
              "type": "integer",
              "minimum": 0
            },
            "targetDisplayAspect": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "eligibleAspectKinds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "forbidKinds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "arLadderTol": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "preferLadder": {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "eligibility": {
          "type": "object",
          "description": "TPC TemplateContract hard eligibility (PRD-TEMPLATE-CONTRACT-V1 §3.1). Undeclared ≡ no hard reject.",
          "additionalProperties": false,
          "properties": {
            "heroDominance": {
              "type": "string",
              "enum": ["extreme", "moderate"]
            },
            "heroAreaBand": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "description": "Hero area as col_frac×row_frac on stage grid"
            },
            "photoCountScale": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "referenceCount": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxHeroAreaAtRef": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "floorFactorAt50": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "canvasAr": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "eligibleAspectKinds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "forbidKinds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "slotIndex": {
              "type": "integer",
              "minimum": 0,
              "description": "Main slot index (migrated from mainSlotPolicy · AC-TPC-04)"
            },
            "targetDisplayAspect": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "arLadderTol": {
              "type": "number",
              "minimum": 0
            },
            "preferLadder": {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    "compatibilityHints": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "prefers_burst": {
          "type": "boolean"
        },
        "min_trip_photos": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_weight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rhythm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_per_chapter": {
              "type": "integer",
              "minimum": 0
            },
            "diversity_bonus": {
              "type": "number"
            }
          }
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gridClass", "cssBundle"],
      "properties": {
        "gridClass": {
          "type": "string",
          "minLength": 1,
          "description": "CSS class until W2 css_gen replaces handwritten classes (R-P16-14)"
        },
        "cssBundle": {
          "type": "string",
          "minLength": 1,
          "description": "Bundle file name, e.g. journal-screens.css"
        },
        "fitPolicy": {
          "type": "string",
          "enum": ["slot", "asset", "auto_delegate", "editorial_row"],
          "description": "Fit resolution policy (R-P16-06); editorial_row delegates to editorial_portrait_row uniform fit"
        },
        "presentation": {
          "type": "string",
          "description": "Named render presentation hook (e.g. editorial-4mix overlay)"
        }
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "hash_key": {
          "type": "string",
          "enum": ["tripId"]
        }
      }
    },
    "generator": {
      "type": "string",
      "description": "Reserved P17: marks auto-generated composite source"
    },
    "usage": {
      "type": "object",
      "description": "Human/AI-facing usage contract: when to (not) use this template and how it differs from confusable siblings",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "One-line positioning; judgment content only, geometry facts stay in structured fields"
        },
        "whenToUse": {
          "type": "string",
          "maxLength": 500
        },
        "whenNotToUse": {
          "type": "string",
          "maxLength": 500,
          "description": "Failure modes / negative guidance; the most valuable section"
        },
        "designIntent": {
          "type": "string",
          "maxLength": 200
        },
        "siblings": {
          "type": "array",
          "description": "Confusable near-neighbour templates and the one-line difference",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "difference"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "difference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          }
        }
      }
    },
    "_legacy": {
      "type": "object",
      "description": "W1 reverse-migration metadata (accepts/css_verified); optional",
      "additionalProperties": true
    }
  },
  "$defs": {
    "slotRect": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "description": "[c0, c1, r0, r1] 1-based closed interval over weighted tracks"
    },
    "slotRole": {
      "type": "string",
      "enum": ["main", "portrait", "landscape", "tile", "square"]
    },
    "slotFit": {
      "type": "string",
      "enum": ["cover", "contain", "auto"]
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "rect", "role"],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "rect": {
          "$ref": "#/$defs/slotRect"
        },
        "role": {
          "$ref": "#/$defs/slotRole"
        },
        "fit": {
          "$ref": "#/$defs/slotFit"
        },
        "visualWeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "displayAspect": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Optional precomputed slot AR; geometry.py derives when absent (W1)"
        },
        "minHeight": {
          "type": "string",
          "description": "Stack templates only (V-P16-S02)"
        }
      }
    }
  }
}
