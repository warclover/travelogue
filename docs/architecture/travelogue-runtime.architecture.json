  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime shape",
      "items": [
        "No Electron/Tauri — PyInstaller opens the system browser",
        "Studio is stdlib ThreadingHTTPServer on loopback",
        "Frontend is static ES modules, not a bundled SPA"
      ]
    },
    {
      "dot": "emerald",
      "title": "Primary import path",
      "items": [
        "POST /__travelogue/import → JobStore → subprocess pipeline",
        "Stages: ingest → cluster/SSG → curate/LSE → narrate → render → export",
        "Progress polled via /__travelogue/jobs/{id}"
      ]
    },
    {
      "dot": "amber",
      "title": "State & egress",
      "items": [
        "SSOT is trips/{id}/trip.json + filesystem assets",
        "Jobs are process-local memory only",
        "LLM and geocode are optional network calls"
      ]
    }
  ]
